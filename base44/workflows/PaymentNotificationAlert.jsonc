{
  "name": "PaymentNotificationAlert",
  "description": "Stripe\u6c7a\u6e08\u5b8c\u4e86\u6642\u306bPaymentNotification\u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u304c\u4f5c\u6210\u3055\u308c\u308b\u3068\u3001\u6703\u9577\u3078\u5373\u5ea7\u306b\u30c1\u30e3\u30c3\u30c8\u901a\u77e5\u3092\u9001\u308b",
  "trigger": {
    "condition": "${ .trigger.data.status == \"pending_invite\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PaymentNotification"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "payment_notification_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_kaicho": {
          "call": "invoke_superagent_step",
          "with": {
            "message": "\ud83d\udd14 \u6c7a\u6e08\u5b8c\u4e86\u901a\u77e5\n\nStripe\u6c7a\u6e08\u304c\u5b8c\u4e86\u3057\u307e\u3057\u305f\u3002\u6703\u9577\u306e\u5224\u65ad\u3067\u62db\u5f85\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n--- \u6c7a\u6e08\u8a73\u7d30 ---\n\u9867\u5ba2\u540d: ${ .trigger.data.customer_name }\n\u30e1\u30fc\u30eb: ${ .trigger.data.customer_email }\n\u5546\u54c1: ${ .trigger.data.product_name }\n\u91d1\u984d: ${ .trigger.data.amount } ${ .trigger.data.currency }\nStripe Session ID: ${ .trigger.data.stripe_session_id }\n----------------\n\n\u3053\u306e\u9867\u5ba2\u3092\u30a2\u30d7\u30ea\u306b\u62db\u5f85\u3057\u307e\u3059\u304b\uff1f\n\u62db\u5f85\u3059\u308b\u5834\u5408\u306f\u300c\u306f\u3044\u300d\u3068\u8fd4\u4fe1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6703\u9577\u304c\u627f\u8a8d\u3057\u305f\u76f8\u624b\u306e\u307f\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002"
          },
          "then": "end",
          "x-base44": {
            "title": "\u6703\u9577\u3078\u6c7a\u6e08\u901a\u77e5",
            "description": "Stripe\u6c7a\u6e08\u5b8c\u4e86\u3092\u5373\u5ea7\u306b\u901a\u77e5"
          }
        }
      }
    ]
  }
}