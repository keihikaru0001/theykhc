{
  "name": "\u5149\u8ca8\u8cfc\u5165\u30c1\u30e3\u30fc\u30b8 \u2014 \u6c7a\u6e08\u5f8c\u81ea\u52d5\u30c1\u30e3\u30fc\u30b8",
  "description": "\u5149\u8ca8\u8cfc\u5165\u306e\u6c7a\u6e08\u5b8c\u4e86\u5f8c\u3001Hikari Sphere\u30a2\u30d7\u30ea\u306ecreditHikari\u95a2\u6570\u3092\u547c\u3073\u51fa\u3057\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u5149\u8ca8\u6b8b\u9ad8\u3092\u81ea\u52d5\u30c1\u30e3\u30fc\u30b8\u3059\u308b\u3002",
  "trigger": {
    "condition": "${ .trigger.data.purchase_type == \"hikari_purchase\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PaymentNotification"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hikari_purchase_credit",
      "namespace": "base44",
      "version": "1.0"
    },
    "do": [
      {
        "credit_hikari": {
          "call": "invoke_superagent_step",
          "with": {
            "message": "\u5149\u8ca8\u8cfc\u5165\u306e\u6c7a\u6e08\u304c\u5b8c\u4e86\u3057\u307e\u3057\u305f\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5149\u8ca8\u3092\u30c1\u30e3\u30fc\u30b8\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n## \u6c7a\u6e08\u30c7\u30fc\u30bf\n- PaymentNotification ID: ${ .trigger.entity_id }\n- player_id: ${ .trigger.data.player_id }\n- hikari_amount: ${ .trigger.data.hikari_amount }\n- \u91d1\u989d: ${ .trigger.data.amount } ${ .trigger.data.currency }\n\n## \u624b\u9806\n1. call_base44_backend_function \u3092\u4f7f\u3063\u3066\u3001Hikari Sphere\u30a2\u30d7\u30ea\uff08app_id: 6a5fa515a25dd96b8fcc7bd0\uff09\u306e creditHikari \u95a2\u6570\u3092\u547c\u3073\u51fa\u3059\n2. payload: { player_id: \"${ .trigger.data.player_id }\", amount: ${ .trigger.data.hikari_amount } }\n3. \u30c1\u30e3\u30fc\u30b8\u6210\u529f\u3092\u78ba\u8a8d\u3057\u305f\u3089\u3001\u6703\u9577\u306b\u5831\u544a:\n   - \u30d7\u30ec\u30a4\u30e4\u30fcID\n   - \u30c1\u30e3\u30fc\u30b8\u5149\u8ca8\u6570\n   - \u65b0\u3057\u3044\u6b8b\u9ad8"
          },
          "then": "end",
          "x-base44": {
            "description": "creditHikari\u3092\u547c\u3073\u51fa\u3057\u3066\u5149\u8ca8\u30c1\u30e3\u30fc\u30b8",
            "title": "\u5149\u8ca8\u30c1\u30e3\u30fc\u30b8\u5b9f\u884c"
          }
        }
      }
    ]
  }
}