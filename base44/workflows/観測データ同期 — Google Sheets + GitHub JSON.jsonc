{
  "name": "\u89b3\u6e2c\u30c7\u30fc\u30bf\u540c\u671f \u2014 Google Sheets + GitHub JSON",
  "description": "\u6bce\u671d9:35 JST\u306b\u89b3\u6e2c\u30c7\u30fc\u30bf\uff08NeutrinoEvent, BiorhythmReading, FxTickSnapshot, KnowledgeStandard\uff09\u3092Google Sheets\u306b\u4fdd\u5b58\u3057\u3001theykhc.com\u7528\u306e\u9759\u7684JSON\u3092GitHub\u306bpush\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "35 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_observation_data",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_observation": {
          "call": "invoke_superagent_step",
          "with": {
            "message": "\u6bce\u671d\u306e\u89b3\u6e2c\u30c7\u30fc\u30bf\u540c\u671f\u30bf\u30b9\u30af\u3067\u3059\u3002\u4ee5\u4e0b\u306e\u624b\u9806\u3092\u5b9f\u884c\u3057\u3066\u304f\u3060\u3055\u3044\uff1a\n\n1. \u4ee5\u4e0b\u306e\u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u304b\u3089\u6700\u65b0\u30c7\u30fc\u30bf\u3092\u53d6\u5f97\u3057\u3066observation-data.json\u3092\u751f\u6210\uff1a\n   - NeutrinoEvent\uff08\u6700\u65b010\u4ef6\u3001gcn_publish_time\u964d\u9806\uff09\n   - BiorhythmReading\uff08\u6700\u65b05\u4ef6\u3001created_date\u964d\u9806\uff09\n   - FxTickSnapshot\uff08\u6700\u65b05\u4ef6\u3001created_date\u964d\u9806\uff09\n   - BrainwaveProxy\uff08\u6700\u65b05\u4ef6\uff09\n   - KnowledgeStandard\uff08\u6700\u65b01\u4ef6\uff09\n   observation_summary\u306b\u5404\u4ef6\u6570\u3068\u539f\u70b9\uff08HIKARI-19890707-PEAK\uff09\u3092\u542b\u3081\u308b\u3002\u5168\u3066\u73fe\u4ee3\u65e5\u672c\u8a9e\u3067\u8a18\u8ff0\u3002\n\n2. get_connector_token\u3067googlesheets\u306e\u30c8\u30fc\u30af\u30f3\u3092\u53d6\u5f97\n\n3. run_skill\u3067sync-observation-data\u30b9\u30ad\u30eb\u3092\u5b9f\u884c\uff08Google Sheets\u66f8\u304d\u8fbc\u307f + GitHub JSON push\uff09\n   \u203b \u30b9\u30ad\u30eb\u5b9f\u884c\u524d\u306bobservation-data.json\u3092\u66f4\u65b0\u6e08\u307f\u306e\u30c7\u30fc\u30bf\u3067\u4e0a\u66f8\u304d\u3059\u308b\u3053\u3068\n\n4. \u4f1a\u9577\u306b\u30c1\u30e3\u30c3\u30c8\u3067\u7d50\u679c\u3092\u5831\u544a\uff1a\n   - NeutrinoEvent: N\u4ef6\n   - BiorhythmReading: N\u4ef6\n   - FxTickSnapshot: N\u4ef6\n   - BrainwaveProxy: N\u4ef6\n   - KnowledgeStandard: TAM/SAM/SOM\u5024\n   - Google Sheets\u66f4\u65b0: \u6210\u529f/\u5931\u6557\n   - GitHub JSON\u66f4\u65b0: \u6210\u529f/\u5931\u6557"
          },
          "then": "end",
          "x-base44": {
            "title": "\u89b3\u6e2c\u30c7\u30fc\u30bf\u540c\u671f",
            "description": "Google Sheets + GitHub JSON"
          }
        }
      }
    ]
  }
}