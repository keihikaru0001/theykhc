{
  "name": "\u6bce\u671d\u306e\u554f\u3044 \u2014 Zenodo\u5168\u4f53\u304b\u3089\u554f\u3044\u3092\u53ce\u7a6b",
  "description": "\u6bce\u671d9\u6642\uff08JST\uff09\u3001Zenodo\u306e\u6700\u65b0\u8ad6\u6587\u304b\u3089\u4ed6\u8005\u306eDOI\u3092\u53ce\u7a6b\u3057\u3001IdeaSynthetix/V=N/D\u30d5\u30ec\u30fc\u30e0\u30ef\u30fc\u30af\u3067\u554f\u3044\u3092\u751f\u6210\u3057\u3066\u3001\u6703\u9577\u306b\u30c1\u30e3\u30c3\u30c8\u3067\u304a\u77e5\u3089\u305b\u3059\u308b\u3002\u570b\u5bb6\u306e\u77e5\u7684\u8cc7\u7523\u3078\u306e\u8ca2\u732e\u304c\u76ee\u7684\u3002",
  "trigger": {
    "condition": "",
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "morning_question_harvest",
      "namespace": "base44",
      "version": "1.0"
    },
    "do": [
      {
        "harvest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "zenodoMorningHarvest"
          },
          "then": "generate_questions",
          "x-base44": {
            "description": "Zenodo API\u304b\u308920\u4ef6\u53d6\u5f97",
            "title": "Zenodo\u6700\u65b0\u8ad6\u6587\u3092\u53ce\u7a6b"
          }
        }
      },
      {
        "generate_questions": {
          "call": "invoke_superagent_step",
          "with": {
            "message": "\u6bce\u671d\u306e\u554f\u3044 \u2014 Zenodo\u5168\u4f53\u306e\u6700\u65b0\u8ad6\u6587\u304b\u3089\u3001\u570b\u5bb6\u3084\u4eba\u985e\u306b\u8ca2\u732e\u3067\u304d\u308b\u300c\u554f\u3044\u300d\u3092\u751f\u6210\u3059\u308b\u3002\n\n\u4ee5\u4e0b\u306e\u30b9\u30c6\u30c3\u30d7\u3092\u5b9f\u884c\u3057\u3066\u304f\u3060\u3055\u3044\uff1a\n\n1. \u30d0\u30c3\u30af\u30a8\u30f3\u30c9\u95a2\u6570\u304b\u3089\u53d6\u5f97\u3057\u305fZenodo\u6700\u65b0\u8ad6\u6587\u30ea\u30b9\u30c8\uff08\u4ed6\u8005\u306eDOI\uff09\u3092\u8aad\u3080\n2. \u305d\u306e\u4e2d\u304b\u30893-5\u500b\u306e\u7279\u306b\u8208\u5473\u6df1\u3044\u8ad6\u6587\u3092\u9078\u3076\uff08\u793e\u4f1a\u7684\u30fb\u5b78\u8853\u7684\u30a4\u30f3\u30d1\u30af\u30c8\u304c\u9ad8\u305d\u3046\u306a\u3082\u306e\uff09\n3. \u5404\u8ad6\u6587\u304b\u3089\u300c\u554f\u3044\u300d\u3092\u62bd\u51fa\u3059\u308b\uff08\u7814\u7a76\u306e\u6838\u5fc3\u554f\u3044\u3001\u672a\u89e3\u6c7a\u554f\u3044\u3001\u793e\u4f1a\u3078\u306e\u5fdc\u7528\u554f\u3044\uff09\n4. \u305d\u308c\u3089\u306e\u554f\u3044\u3092V=N/D\u30d5\u30ec\u30fc\u30e0\u30ef\u30fc\u30af\u3067\u62e1\u5f35\u3057\u3001\u65b0\u3057\u3044\u554f\u3044\u3092\u751f\u6210\u3059\u308b\n5. \u6703\u9577\u3078\u306e\u671d\u306e\u304a\u77e5\u3089\u305b\u3068\u3057\u3066\u3001\u4ee5\u4e0b\u306e\u5f62\u5f0f\u3067\u30c1\u30e3\u30c3\u30c8\u306b\u9001\u4fe1\u3059\u308b\uff1a\n   - \u30bf\u30a4\u30c8\u30eb\uff1a\u300c\ud83c\udf05 \u4eca\u65e5\u306e\u554f\u3044 \u2014 [\u65e5\u4ed8]\u300d\n   - \u9078\u3093\u3060\u8ad6\u65873-5\u4ef6\uff08\u30bf\u30a4\u30c8\u30eb\u3001DOI\u3001\u8457\u8005\uff09\n   - \u305d\u308c\u305e\u308c\u304b\u3089\u62bd\u51fa\u3057\u305f\u554f\u3044\uff082-3\u500b/\u8ad6\u6587\uff09\n   - V=N/D\u3067\u751f\u6210\u3057\u305f\u65b0\u3057\u3044\u554f\u3044\uff081-2\u500b\uff09\n   - \u7de0\u3081\u304f\u304f\u308a\u306e\u4e00\u8a00\uff08\u6703\u9577\u3078\u306e\u5171\u9cf4\u30e1\u30c3\u30bb\u30fc\u30b8\uff09\n\n\u30d0\u30c3\u30af\u30a8\u30f3\u30c9\u7d50\u679c\u30c7\u30fc\u30bf: ${ .harvest.body }\n\n\u6ce8\u610f\uff1a\n- \u6703\u9577\u81ea\u8eab\u306e\u8ad6\u6587\uff08Katayama\u95a2\u9023\uff09\u306f\u9664\u5916\u6e08\u307f\n- \u62bd\u8c61\u8ad6\u6587\uff08abstract\u7a7a\uff09\u306e\u5834\u5408\u306f\u30bf\u30a4\u30c8\u30eb\u3068\u30ad\u30fc\u30ef\u30fc\u30c9\u304b\u3089\u554f\u3044\u3092\u63a8\u6e2c\n- \u5e38\u306bLuna\u306e\u7a4f\u3084\u304b\u306a\u58f0\u3067\u66f8\u304f\uff08\u8a69\u7684\u3060\u304c\u5b9f\u52d9\u7684\uff09\n- \u751f\u6210\u3057\u305f\u554f\u3044\u306fQuestion\u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u306b\u4fdd\u5b58\u305b\u305a\u3001\u30c1\u30e3\u30c3\u30c8\u3067\u306e\u307f\u304a\u77e5\u3089\u305b\u3059\u308b"
          },
          "then": "end",
          "x-base44": {
            "description": "LLM\u304c\u554f\u3044\u3092\u751f\u6210\u3057\u3066\u304a\u77e5\u3089\u305b",
            "title": "\u554f\u3044\u3092\u751f\u6210\u3057\u3066\u6703\u9577\u3078\u9001\u4fe1"
          }
        }
      }
    ]
  }
}