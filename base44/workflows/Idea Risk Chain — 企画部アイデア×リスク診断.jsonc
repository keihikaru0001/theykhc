{
  "name": "Idea Risk Chain \u2014 \u4f01\u753b\u90e8\u30a2\u30a4\u30c7\u30a2\u00d7\u30ea\u30b9\u30af\u8a3a\u65ad",
  "description": "BusinessProfile\u304c\u4f5c\u6210\u3055\u308c\u305f\u969b\u3001IdeaSynthetix\u30673\u3064\u306e\u4e8b\u696d\u30a2\u30a4\u30c7\u30a2\u3092\u751f\u6210\u3057\u3001\u305d\u308c\u305e\u308c\u30925\u5c64\u30ea\u30b9\u30af\u8a3a\u65ad\uff08V=N/D\uff09\u306b\u304b\u3051\u3066\u3001\u6bd4\u8f03\u30ec\u30dd\u30fc\u30c8\u3092\u6703\u9577\u306b\u5c4a\u3051\u308b\u3002",
  "trigger": {
    "condition": "${ (.trigger.data.challenge_summary // \"\") != \"\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BusinessProfile"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "idea_risk_chain",
      "namespace": "base44",
      "version": "1.0"
    },
    "do": [
      {
        "generate_and_assess": {
          "call": "invoke_backend_function",
          "with": {
            "args": {
              "challenge_summary": "${ .trigger.data.challenge_summary }",
              "company_name": "${ .trigger.data.company_name }",
              "founder_name": "${ .trigger.data.founder_name }",
              "industry": "${ .trigger.data.industry }",
              "stage": "${ .trigger.data.stage }",
              "topic": "${ .trigger.data.challenge_summary }"
            },
            "function_name": "ideaRiskChain"
          },
          "then": "deliver_report",
          "x-base44": {
            "description": "3\u4e8b\u696d\u6848\u3092\u751f\u6210\u3057\u5404\u3005V=N/D\u8a55\u4fa1",
            "title": "\u30a2\u30a4\u30c7\u30a2\u751f\u6210\u00d75\u5c64\u30ea\u30b9\u30af\u8a3a\u65ad"
          }
        }
      },
      {
        "deliver_report": {
          "call": "invoke_superagent_step",
          "with": {
            "message": "\u4f01\u753b\u90e8\u5411\u3051\u30a2\u30a4\u30c7\u30a2\u00d7\u30ea\u30b9\u30af\u8a3a\u65ad\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u304c\u5b9f\u884c\u3055\u308c\u307e\u3057\u305f\u3002\u4ee5\u4e0b\u306e\u7d50\u679c\u3092\u6703\u9577\u306b\u5206\u304b\u308a\u3084\u3059\u304f\u5c4a\u3051\u3066\u304f\u3060\u3055\u3044\uff1a1. \u751f\u6210\u3055\u308c\u305f3\u3064\u306e\u4e8b\u696d\u30a2\u30a4\u30c7\u30a2\u3068\u305d\u308c\u305e\u308c\u306e\u6982\u8981 2. \u5404\u30a2\u30a4\u30c7\u30a2\u306eV=N/D\u30b9\u30b3\u30a2\uff080-10\uff09\u3068\u30ea\u30b9\u30af\u30ec\u30d9\u30eb 3. \u30e9\u30f3\u30ad\u30f3\u30b0\uff08\u30b9\u30b3\u30a2\u9806\uff094. \u6bd4\u8f03\u30ec\u30dd\u30fc\u30c8\u306e\u30b5\u30de\u30ea\u30fc 5. \u5404\u30a2\u30a4\u30c7\u30a2\u306e5\u5c64\u5206\u6790\u306e\u8981\u7d04\u3002\u7d50\u679c\u30c7\u30fc\u30bf: ${ .generate_and_assess.body }"
          },
          "then": "end",
          "x-base44": {
            "description": "\u6bd4\u8f03\u30ec\u30dd\u30fc\u30c8\u3092\u30c1\u30e3\u30c3\u30c8\u3067\u5c4a\u3051\u308b",
            "title": "\u6703\u9577\u3078\u7d50\u679c\u9001\u4fe1"
          }
        }
      }
    ]
  }
}