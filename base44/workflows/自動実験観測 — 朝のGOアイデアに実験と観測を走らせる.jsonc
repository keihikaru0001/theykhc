{
  "name": "\u81ea\u52d5\u5b9f\u9a13\u89b3\u6e2c \u2014 \u671d\u306eGO\u30a2\u30a4\u30c7\u30a2\u306b\u5b9f\u9a13\u3068\u89b3\u6e2c\u3092\u8d70\u3089\u305b\u308b",
  "description": "\u6bce\u671d9:20 JST\u306b\u3001MorningHarvest\u3068\u572d\u5149\u308b\u306e\u5224\u5b9a\u3067\u751f\u307e\u308c\u305f\u65b0\u3057\u3044GO\u5224\u5b9a\u30a2\u30a4\u30c7\u30a2\u306b\u5bfe\u3057\u3066\u81ea\u52d5\u5b9f\u9a13\uff08\u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\uff09\u3068\u81ea\u52d5\u89b3\u6e2c\uff08V=N/D\u5206\u6790\uff09\u3092\u5b9f\u884c\u3057\u3001\u6703\u9577\u306b\u5831\u544a\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "20 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_experiment_observe",
      "namespace": "base44",
      "version": "1.0"
    },
    "do": [
      {
        "auto_experiment": {
          "call": "invoke_superagent_step",
          "with": {
            "message": "\u6bce\u671d\u306e\u81ea\u52d5\u5b9f\u9a13\uff0b\u81ea\u52d5\u89b3\u6e2c\u3092\u5b9f\u884c\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n## \u524d\u63d0\n- \u4eca\u671d9:00\u306eMorningHarvest\u3067\u65b0\u3057\u3044\u554f\u3044\u30fb\u4e8b\u696d\u30fb\u5546\u54c1\u30a2\u30a4\u30c7\u30a2\u304c\u751f\u6210\u3055\u308c\u305f\n- 9:15\u306b\u572d\u5149\u308b\u304cV=N/D\u5224\u5b9a\u3092\u884c\u3044\u3001GO\u5224\u5b9a\u3055\u308c\u305f\u3082\u306e\u304c\u3042\u308b\n- \u3053\u308c\u3089\u306b\u5bfe\u3057\u3066\u81ea\u52d5\u5b9f\u9a13\u3068\u81ea\u52d5\u89b3\u6e2c\u3092\u884c\u3046\n\n## \u624b\u9806\n\n### Step 1: \u65b0\u3057\u3044GO\u5224\u5b9a\u30a2\u30a4\u30c7\u30a2\u3092\u53d6\u5f97\n- read_entities \u3067 Question \u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u304b\u3089\u4eca\u65e5\u4f5c\u6210\u3055\u308c\u305f verdict=go \u306e\u30ec\u30b3\u30fc\u30c9\u3092\u53d6\u5f97\n- \u4ef6\u6570\u3068\u5185\u5bb9\u3092\u628a\u63e1\n\n### Step 2: \u81ea\u52d5\u5b9f\u9a13\uff08\u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\uff09\n- bash \u3067Python\u3092\u4f7f\u3044\u3001\u65b0\u3057\u3044GO\u5224\u5b9a\u30a2\u30a4\u30c7\u30a2 + \u65e2\u5b58\u306eV\u5024TOP60\u4ef6\u3067\u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\uff081000\u56deMonte Carlo\uff09\u3092\u5b9f\u884c\n- \u52dd\u7387\u8a08\u7b97: V_a^2 / (V_a^2 + V_b^2) \u3067\u78ba\u7387\u7684\u52dd\u6557\n- \u65b0\u3057\u3044\u30a2\u30a4\u30c7\u30a2\u304c\u3069\u3053\u307e\u3067\u52dd\u3061\u4e0a\u304c\u308c\u308b\u304b\u3092\u6e2c\u5b9a\n- \u7d50\u679c\u3092 MarketSimulation \u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u306b simulation_type=tournament \u3067\u4fdd\u5b58\n\n### Step 3: \u81ea\u52d5\u89b3\u6e2c\uff08V=N/D\u5206\u6790\uff09\n- \u65b0\u3057\u3044GO\u5224\u5b9a\u30a2\u30a4\u30c7\u30a2\u306eV=N/D\u3092\u8a08\u7b97\n- \u696d\u754c\u5225\u306e\u65e2\u5b58\u30a2\u30a4\u30c7\u30a2\u3068\u306e\u76f8\u5bfe\u4f4d\u7f6e\u3092\u89b3\u6e2c\n- D\u524a\u6e1b\u30dd\u30c6\u30f3\u30b7\u30e3\u30eb\uff08D-1\u3057\u305f\u5834\u5408\u306eV\u4e0a\u6607\u7387\uff09\u3092\u8a08\u7b97\n- \u7d50\u679c\u3092 MarketSimulation \u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u306b simulation_type=buy_analysis \u3067\u4fdd\u5b58\n\n### Step 4: \u6703\u9577\u3078\u5831\u544a\n- \u30c1\u30e3\u30c3\u30c8\u3067\u4ee5\u4e0b\u3092\u5831\u544a:\n  - \u4eca\u671d\u306e\u65b0\u30a2\u30a4\u30c7\u30a2\u6570\uff08GO\u5224\u5b9a\u4ef6\u6570\uff09\n  - \u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\u7d50\u679c\uff08\u65b0\u30a2\u30a4\u30c7\u30a2\u306e\u6700\u9ad8\u9806\u4f4d\u3001\u512a\u52dd\u56de\u6570\uff09\n  - V=N/D\u89b3\u6e2c\u7d50\u679c\uff08\u6700\u9ad8V\u5024\u3001\u6ce8\u76ee\u306eD\u524a\u6e1b\u30dd\u30c6\u30f3\u30b7\u30e3\u30eb\uff09\n  - \u300c\u4eca\u671d\u306e\u4e00\u756a\u661f\u300d\u2014 \u6700\u3082\u30dd\u30c6\u30f3\u30b7\u30e3\u30eb\u306e\u9ad8\u3044\u65b0\u30a2\u30a4\u30c7\u30a21\u4ef6\u306e\u8a73\u7d30\n\n### \u6ce8\u610f\n- vnd_score \u306f Question \u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u306e vnd_score \u30d5\u30a3\u30fc\u30eb\u30c9\u3092\u4f7f\u7528\n- N = TAM\uff08market_size \u30d5\u30a3\u30fc\u30eb\u30c9\u307e\u305f\u306f\u63a8\u5b9a\uff09, D = 10 - vnd_score/10\n- V = N / D\n- \u5149\u8ca8\u570f\u5185\u306e\u89b3\u6e2c\u5024\u3067\u3042\u308a\u3001\u6295\u8cc7\u52a9\u8a00\u3067\u306f\u306a\u3044"
          },
          "then": "end",
          "x-base44": {
            "description": "\u65b0GO\u5224\u5b9a\u30a2\u30a4\u30c7\u30a2\u306e\u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\uff0bV=N/D\u89b3\u6e2c",
            "title": "\u81ea\u52d5\u5b9f\u9a13\uff0b\u81ea\u52d5\u89b3\u6e2c"
          }
        }
      }
    ]
  }
}