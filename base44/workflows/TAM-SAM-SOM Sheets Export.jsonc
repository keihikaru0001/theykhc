  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tam_sam_som_sheets_export",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "fetch_data": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportTamSamSom",
            "args": {}
          },
          "then": "write_to_sheets",
          "x-base44": {
            "title": "TAM/SAM/SOM\u96c6\u8a08\u30c7\u30fc\u30bf\u53d6\u5f97",
            "description": "GO\u5224\u5b9a\u30a2\u30a4\u30c7\u30a2\u304b\u3089\u5e02\u5834\u898f\u6a21\u3092\u62bd\u51fa"
          }
        }
      },
      {
        "write_to_sheets": {
          "call": "invoke_superagent_step",
          "with": {
            "message": "TAM/SAM/SOM\u96c6\u8a08\u30c7\u30fc\u30bf\u3092Google\u30b9\u30d7\u30ec\u30c3\u30c9\u30b7\u30fc\u30c8\u306b\u66f8\u304d\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\u3002\n\n\u30b9\u30d7\u30ec\u30c3\u30c9\u30b7\u30fc\u30c8ID: 1MI_IncRsxr6ZcJiXq1lDlj7E2K8-iSBgu0HGW9v2y9E\nURL: https://docs.google.com/spreadsheets/d/1MI_IncRsxr6ZcJiXq1lDlj7E2K8-iSBgu0HGW9v2y9E/edit\n\n\u4ee5\u4e0b\u306e\u30c7\u30fc\u30bf\u3092\u53d6\u5f97\u3057\u307e\u3057\u305f\uff1a\n${ .fetch_data }\n\n\u30b7\u30fc\u30c81\u300c\u696d\u754c\u5225\u96c6\u8a08\u300d\u306b\u4ee5\u4e0b\u306e\u30d8\u30c3\u30c0\u30fc\u3067\u66f8\u304d\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\uff1a\nA1: \u696d\u754c\nB1: \u30a2\u30a4\u30c7\u30a2\u6570\nC1: \u5e02\u5834\u898f\u6a21\u3042\u308a\nD1: TAM\u5408\u8a08\uff08\u5104\u5186\uff09\nE1: SAM\u5408\u8a08\uff08\u5104\u5186\uff09\nF1: SOM\u5408\u8a08\uff08\u5104\u5186\uff09\nG1: \u5e73\u5747V=N/D\u30b9\u30b3\u30a2\nH1: \u5e73\u5747CAGR(%)\n\n\u5404\u696d\u754c\u306e\u30c7\u30fc\u30bf\u30922\u884c\u76ee\u4ee5\u964d\u306b\u66f8\u304d\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\u3002\n\u6700\u5f8c\u306b\u5408\u8a08\u884c\u3092\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\nGoogle Sheets \u30c8\u30fc\u30af\u30f3\u306f $GOOGLESHEETS_ACCESS_TOKEN \u74b0\u5883\u5909\u6570\u3068\u3057\u3066\u5229\u7528\u53ef\u80fd\u3067\u3059\u3002Python\u3067 urllib.request \u3092\u4f7f\u3063\u3066 Sheets API v4 \u306b\u66f8\u304d\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\u3002"
          },
          "then": "end",
          "x-base44": {
            "title": "\u30b9\u30d7\u30ec\u30c3\u30c9\u30b7\u30fc\u30c8\u3078\u66f8\u304d\u8fbc\u307f",
            "description": "\u96c6\u8a08\u30c7\u30fc\u30bf\u3092Google Sheets\u306b\u66f8\u304d\u8fbc\u3080"
          }
        }
      }
    ]
  }
}