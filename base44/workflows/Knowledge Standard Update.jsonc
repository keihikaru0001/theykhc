{
  "name": "Knowledge Standard Update",
  "description": "\u6bce\u671d9:30\u306bTAM/SAM/SOM\u96c6\u8a08\u3092\u66f4\u65b0\u3057\u3001KnowledgeStandard\u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u306e\u88cf\u4ed8\u3051\u5024\u3092\u81ea\u52d5\u6210\u9577\u3055\u305b\u308b\u3002MorningHarvest\u306e30\u5206\u5f8c\u306b\u5b9f\u884c\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "knowledge_standard_update",
      "namespace": "base44",
      "version": "1.0"
    },
    "do": [
      {
        "fetch_totals": {
          "call": "invoke_backend_function",
          "then": "update_standard",
          "with": {
            "args": {},
            "function_name": "exportTamSamSom"
          },
          "x-base44": {
            "description": "GO\u5224\u5b9a\u30a2\u30a4\u30c7\u30a2\u304b\u3089\u6700\u65b0\u306eTAM/SAM/SOM\u5408\u8a08\u3092\u53d6\u5f97",
            "title": "TAM/SAM/SOM\u96c6\u8a08\u53d6\u5f97"
          }
        }
      },
      {
        "update_standard": {
          "call": "invoke_superagent_step",
          "then": "end",
          "with": {
            "message": "\u77e5\u8b58\u672c\u4f4d\u5236\uff08KnowledgeStandard\uff09\u306e\u88cf\u4ed8\u3051\u5024\u3092\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u4ee5\u4e0b\u306e\u30c7\u30fc\u30bf\u3092\u53d6\u5f97\u3057\u307e\u3057\u305f\uff1a\n${ .fetch_totals }\n\n\u3084\u308b\u3053\u3068\uff1a\n1. KnowledgeStandard\u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u306b\u65b0\u3057\u3044\u30ec\u30b3\u30fc\u30c9\u3092\u4f5c\u6210\u3002observation_date\u306f\u4eca\u65e5\u306e\u65e5\u4ed8\u3002\n2. grandTotal.totalTam\uff08\u5104\u5186\uff09\u3092\u5146\u5186\u306b\u5909\u63db\u3057\u3066tam_trillion_yen\u306b\u683c\u7d0d\uff08/ 10000\uff09\n3. grandTotal.totalSam\uff08\u5104\u5186\uff09\u3092\u5146\u5186\u306b\u5909\u63db\u3057\u3066sam_trillion_yen\u306b\u683c\u7d0d\uff08/ 10000\uff09\n4. grandTotal.totalSom\uff08\u5104\u5186\uff09\u3092\u5146\u5186\u306b\u5909\u63db\u3057\u3066som_trillion_yen\u306b\u683c\u7d0d\uff08/ 10000\uff09\n5. go_idea_count\u306bgrandTotal.totalIdeas\u3092\u683c\u7d0d\n6. doi_count\u306fZenodo API\u304b\u3089\u53d6\u5f97\uff08https://zenodo.org/api/records?size=0&q=creators.name:\"Katayama, Yoshimitsu\"\"\u306ehit.total\u3092\u53c2\u7167\uff09\n7. \u6703\u9577\u3078\u30c1\u30e3\u30c3\u30c8\u3067\u7d50\u679c\u3092\u5831\u544a\n\n\u524d\u56de\u306e\u89b3\u6e2c\u5024\u3068\u306e\u5dee\u5206\u3082\u8868\u793a\u3057\u3066\u304f\u3060\u3055\u3044\uff08\u4f8b\uff1aTAM +1.2\u5146\u5186\u3001GO +3\u4ef6\u306a\u3069\uff09\u3002"
          },
          "x-base44": {
            "description": "KnowledgeStandard\u30a8\u30f3\u30c6\u30a3\u30c6\u30a3\u3092\u66f4\u65b0\u3057\u3001\u6703\u9577\u3078\u5831\u544a",
            "title": "\u77e5\u8b58\u672c\u4f4d\u5236 \u66f4\u65b0\u3068\u5831\u544a"
          }
        }
      }
    ]
  }
}